# Copy to .env and adjust paths for your host.
MODEL_DIR=/data/models/DeepSeek-V4.1-Flash

# The public default is loopback-only. Add authentication before exposing it.
HOST=127.0.0.1
PORT=8011
SERVED_MODEL_NAME=deepseek-v4.1-flash

CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=4096
GPU_MEMORY_UTILIZATION=0.92

ENABLE_CED=1
ENABLE_PREFIX_CACHING=1
ENABLE_DSPARK=1
NUM_SPECULATIVE_TOKENS=5
ENABLE_ADAPTIVE_VERIFICATION=1

# Optional installation settings.
# PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# VENV=/path/to/.venv
# CUDA_HOME=/usr/local/cuda-13.0
